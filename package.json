{
	"name": "post-kinds-for-indieweb-in-block-themes",
	"version": "1.8.6",
	"description": "Modern block editor support for IndieWeb post kinds and microformats. A successor to the classic IndieWeb Post Kinds plugin.",
	"author": "Courtney Robertson",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"indieweb",
		"post-kinds",
		"microformats",
		"gutenberg",
		"blocks"
	],
	"homepage": "https://github.com/courtneyr-dev/post-kinds-for-indieweb#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/courtneyr-dev/post-kinds-for-indieweb.git"
	},
	"bugs": {
		"url": "https://github.com/courtneyr-dev/post-kinds-for-indieweb/issues"
	},
	"engines": {
		"node": ">=22.22.2",
		"npm": ">=11.0.0"
	},
	"files": [
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"admin/",
		"assets/",
		"blueprints/",
		"build/",
		"includes/",
		"languages/",
		"patterns/",
		"post-kinds-for-indieweb-in-block-themes.php",
		"readme.txt",
		"styles/",
		"templates/",
		"uninstall.php"
	],
	"main": "build/index.js",
	"dependencies": {
		"@wordpress/api-fetch": "^7.56.0",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/blocks": "^16.1.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/compose": "^8.3.0",
		"@wordpress/core-data": "^8.1.0",
		"@wordpress/data": "^10.0.0",
		"@wordpress/editor": "^15.1.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/hooks": "^4.53.0",
		"@wordpress/i18n": "^6.10.0",
		"@wordpress/icons": "^17.0.0",
		"@wordpress/plugins": "^7.0.0",
		"@wordpress/primitives": "^4.0.0",
		"@wordpress/server-side-render": "^6.32.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@babel/core": "^7.29.7",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.63.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@wordpress/babel-preset-default": "^8.56.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/jest-preset-default": "^14.2.0",
		"@wordpress/scripts": "^36.0.0",
		"babel-jest": "^30.5.0",
		"husky": "^9.0.0",
		"jest": "^30.5.0",
		"jest-environment-jsdom": "^30.5.0",
		"lint-staged": "^17.5.1"
	},
	"scripts": {
		"build": "wp-scripts build && node bin/sync-block-assets.mjs",
		"build:prod": "wp-scripts build --mode=production && node bin/sync-block-assets.mjs",
		"start": "wp-scripts start",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:pkg-json",
		"lint:js": "wp-scripts lint-js src/",
		"lint:js:fix": "wp-scripts lint-js src/ --fix",
		"lint:css": "wp-scripts lint-style 'src/**/*.{css,scss}'",
		"lint:css:fix": "wp-scripts lint-style 'src/**/*.{css,scss}' --fix",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format",
		"test": "npm run test:unit",
		"test:js": "wp-scripts test-unit-jest --config jest.config.js",
		"test:unit": "wp-scripts test-unit-jest --config jest.config.js",
		"test:unit:watch": "wp-scripts test-unit-jest --config jest.config.js --watch",
		"test:unit:coverage": "wp-scripts test-unit-jest --config jest.config.js --coverage",
		"test:e2e": "playwright test",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:ui": "playwright test --ui",
		"test:a11y": "playwright test tests/e2e/accessibility.spec.js",
		"test:visual": "playwright test --update-snapshots",
		"lighthouse": "lhci autorun",
		"audit": "npm audit --audit-level=high",
		"audit:fix": "npm audit fix",
		"security": "npm run audit && echo 'Run composer audit separately'",
		"i18n:check": "wp-scripts lint-md-docs && npm run lint:js -- --rule '@wordpress/i18n-text-domain: error'",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean",
		"env:cli": "wp-env run cli wp",
		"env:logs": "wp-env logs",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"prepare": "husky",
		"check": "npm run lint && npm run test:unit && npm run audit",
		"screenshots:docs": "node scripts/capture-docs-screenshots.js"
	},
	"overrides": {
		"@lhci/cli": {
			"tmp": "0.2.7",
			"uuid": "11.1.1"
		},
		"copy-webpack-plugin": {
			"serialize-javascript": "7.1.2"
		},
		"markdownlint-cli": {
			"js-yaml": "5.4.2",
			"smol-toml": "1.9.0"
		},
		"micromark-extension-math": {
			"katex": "0.18.9"
		},
		"postcss-selector-parser": "7.1.6",
		"sockjs": {
			"uuid": "11.1.1"
		}
	}
}

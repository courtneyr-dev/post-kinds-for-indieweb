# Directories to exclude from distribution
/.git
/.github
/.claude
/.husky
/.omc
/node_modules
/vendor
/tests
/bin
/src
/scripts

# Hidden/config files to exclude
.distignore
.DS_Store
.editorconfig
.gitignore
.gitattributes
.gitkeep
.lintstagedrc.json
.phpcs.xml.dist
.phpcs.cache
.phpunit.result.cache
.wp-env.json

# Build/dev tooling
composer.json
composer.lock
package.json
package-lock.json
phpunit.xml.dist
phpstan.neon
webpack.config.js
eslint.config.js
jest.config.js
playwright.config.js
lighthouserc.js
phpstan-baseline.neon

# Marketing and documentation imagery. Nothing in the shipped plugin reads
# it — the directory listing is fed from .wordpress-org/ instead — and it is
# the single largest thing in the download.
/img

# Banners, icons, and screenshots for the plugin directory listing. These
# belong in the SVN repo's own assets/ directory, never in trunk — shipping
# them would add ~6M to every download.
/.wordpress-org

# Development documentation
CLAUDE.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
SECURITY.md
SUPPORT.md
TESTING.md
/stubs
/docs

# CI-only checkout of the companion plugin for the live integration suite
# (.github/workflows/ci.yml); never part of the distribution.
/wordpress-atmosphere

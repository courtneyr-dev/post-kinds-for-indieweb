{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/post-new.php",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "post-kinds-for-indieweb-in-block-themes"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "indieblocks"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Post Kinds Demo",
				"blogdescription": "Modern IndieWeb post kinds for the block editor",
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/courtneyr-dev/indieweb-test-data/62a8dbc66bd0814ea720bd23f3893a16d499ff20/indieweb-test-data-small.xml"
			}
		}
	]
}

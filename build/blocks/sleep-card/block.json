{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "post-kinds-indieweb/sleep-card",
	"version": "1.0.0",
	"title": "Sleep Card",
	"category": "post-kinds-indieweb",
	"description": "Record a night's sleep: how long you slept, and the bed and wake times you choose to share.",
	"keywords": ["sleep", "night", "rest", "bedtime", "moon"],
	"textdomain": "post-kinds-for-indieweb-in-block-themes",
	"attributes": {
		"durationMinutes": {
			"type": "integer"
		},
		"bedtime": {
			"type": "string"
		},
		"wakeTime": {
			"type": "string"
		},
		"showTimesPublicly": {
			"type": "boolean",
			"default": false
		},
		"origin": {
			"type": "string"
		}
	},
	"usesContext": ["postId"],
	"supports": {
		"html": false
	},
	"render": "file:./render.php"
}
